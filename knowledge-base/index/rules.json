{
  "schemaVersion": 1,
  "about": "規則唯一事實來源（knowledge-base/decisions/2026-10-21-kb-asset-architecture.md §5.1）。把關程式經 shared/tools/rules.mjs 取值；遊戲例外寫在 <Game>/config/rules.overrides.json。",
  "rules": [
    {
      "id": "RULE-BUNDLE-SIZE",
      "category": "tech",
      "level": "must",
      "scope": { "selector": { "kind": "game-build" } },
      "constraints": [
        { "name": "target", "op": "<=", "value": 8388608, "unit": "byte", "overridePolicy": "with-reason" },
        { "name": "hard", "op": "<=", "value": 10485760, "unit": "byte", "overridePolicy": "forbid" }
      ],
      "measurement": "npm run build 後 dist/ 內所有檔案原始大小總和（不計 gzip / brotli）；超過 target 即失敗",
      "enforcement": { "type": "script", "ref": "<Game>/game/scripts/size-check.mjs（範本 templates/scripts/size-check.mjs）" },
      "whyRef": "knowledge-base/04_tech-stack.md",
      "howRef": ".claude/skills/lite-skillgame-stack/references/stack-and-budget.md",
      "source": "CLAUDE.md、SwarmDuel/docs/size_budget.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-NO-RUNTIME-CDN",
      "category": "tech",
      "level": "must",
      "scope": { "selector": { "kind": "game-build" } },
      "constraints": [{ "name": "allowed", "check": "dist/ 的 js / css / html / json / svg 不得引用 cdn.jsdelivr.net、unpkg.com、cdnjs.cloudflare.com", "overridePolicy": "forbid" }],
      "measurement": "size-check 掃描 dist/ 文字檔中的 CDN 網址",
      "enforcement": { "type": "script", "ref": "<Game>/game/scripts/size-check.mjs（目前只警告）" },
      "whyRef": "knowledge-base/04_tech-stack.md",
      "howRef": ".claude/skills/lite-skillgame-stack/SKILL.md",
      "source": "CLAUDE.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-DRAWCALL-2D",
      "category": "tech",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "renderer": "2d" } },
      "constraints": [{ "name": "base", "op": "<=", "value": 5, "unit": "draw-call", "overridePolicy": "with-reason" }],
      "measurement": "開發模式 DC 計數器（src/debug/drawCalls.js）在基礎畫面的讀數；特效全開時寫明峰值",
      "enforcement": { "type": "review", "checklist": "交付前截圖 DC 計數器" },
      "whyRef": "knowledge-base/04_tech-stack.md",
      "howRef": ".claude/skills/lite-skillgame-stack/references/drawcalls-assets.md",
      "source": "CLAUDE.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-DRAWCALL-3D",
      "category": "tech",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "renderer": "3d" } },
      "constraints": [{ "name": "base", "op": "<=", "value": 9, "unit": "draw-call", "overridePolicy": "with-reason" }],
      "measurement": "同 RULE-DRAWCALL-2D",
      "enforcement": { "type": "review", "checklist": "交付前截圖 DC 計數器" },
      "whyRef": "knowledge-base/04_tech-stack.md",
      "howRef": ".claude/skills/lite-skillgame-stack/references/drawcalls-assets.md",
      "source": "CLAUDE.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-SIM-PURITY",
      "category": "fairness",
      "level": "must",
      "scope": { "selector": { "kind": "game-source", "path": "game/src/sim/" } },
      "constraints": [{ "name": "forbidden", "check": "sim/ 內不得出現 gsap、pixi、document、Math.random、Date", "overridePolicy": "forbid" }],
      "measurement": "grep -rnE \"gsap|pixi|document|Math\\.random|Date\" src/sim/（排除 core/ 註解）",
      "enforcement": { "type": "review", "checklist": "交付前執行上列 grep，結果為空" },
      "whyRef": "knowledge-base/01_skill-integrity.md",
      "howRef": ".claude/skills/lite-skillgame-stack/SKILL.md",
      "source": "CLAUDE.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-SKILL-DOMINANCE",
      "category": "fairness",
      "level": "must",
      "scope": { "selector": { "kind": "game-build" } },
      "constraints": [
        { "name": "skillShare", "op": ">=", "value": 0.7, "unit": "ratio", "overridePolicy": "forbid" },
        { "name": "topWinRate", "op": ">=", "value": 0.7, "unit": "ratio", "overridePolicy": "forbid" }
      ],
      "measurement": "node tools/skill-dominance.mjs 30：30 個種子 × ≥ 3 級技巧 bot；skillShare = 技巧等級佔分數變異比例，topWinRate = 最強對次強同種子勝率",
      "enforcement": { "type": "script", "ref": "<Game>/game/tools/lib/dominance.mjs（範本 templates/tools/lib/dominance.mjs）" },
      "whyRef": "knowledge-base/01_skill-integrity.md",
      "howRef": "knowledge-base/12_genre-recipes.md",
      "source": "knowledge-base/01_skill-integrity.md §4",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-TREND",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "difficulty": "scripted" } },
      "constraints": [{ "name": "rho", "op": ">=", "value": 0.6, "unit": "spearman", "overridePolicy": "with-reason" }],
      "measurement": "主段落逐單位 DI 對時間的 Spearman ρ（tools/playtest.mjs）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D2",
      "howRef": "knowledge-base/16_difficulty-curve.md §5",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-LINEARITY",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "difficulty": "scripted" } },
      "constraints": [{ "name": "r2", "op": ">=", "value": 0.5, "unit": "r-squared", "overridePolicy": "with-reason" }],
      "measurement": "主段落 DI 對時間的線性擬合 R²（tools/playtest.mjs）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D3",
      "howRef": "knowledge-base/16_difficulty-curve.md §5",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-PEAKS",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "difficulty": "scripted" } },
      "constraints": [{ "name": "tolerance", "op": "<=", "value": 0.05, "unit": "DI", "overridePolicy": "with-reason" }],
      "measurement": "每個主段落的 DI 高峰 ≥ 前一段高峰 − tolerance（tools/playtest.mjs）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D4",
      "howRef": "knowledge-base/16_difficulty-curve.md §2.2",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-CLIFF",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "difficulty": "scripted" } },
      "constraints": [{ "name": "maxDropPp", "op": "<=", "value": 12, "unit": "percentage-point", "overridePolicy": "with-reason" }],
      "measurement": "一般玩家（humanBots regular）相鄰主段落命中率下降幅度（tools/playtest.mjs、tools/difficulty-curve.mjs）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs、difficulty-curve.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D5",
      "howRef": "knowledge-base/16_difficulty-curve.md §3",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-FLOW",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "difficulty": "scripted" } },
      "constraints": [
        { "name": "min", "op": ">=", "value": 0.9, "unit": "hit-rate", "overridePolicy": "with-reason" },
        { "name": "max", "op": "<=", "value": 0.99, "unit": "hit-rate", "overridePolicy": "with-reason" }
      ],
      "measurement": "一般玩家（humanBots regular）每個主段落的命中率（tools/playtest.mjs）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D6",
      "howRef": "knowledge-base/16_difficulty-curve.md §2.3",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-BEATGRID",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "genre": "rhythm" } },
      "constraints": [{ "name": "onGrid", "check": "所有目標都在拍點或分拍上（節奏類）", "overridePolicy": "with-reason" }],
      "measurement": "譜面只用合法格位（TwinStrike 為八分音格，由建構保證）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D7",
      "howRef": "knowledge-base/12_genre-recipes.md §1",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-CURVE-PHRASE",
      "category": "balance",
      "level": "must",
      "scope": { "selector": { "kind": "game-build", "genre": "rhythm" } },
      "constraints": [{ "name": "multipleOf", "op": "==", "value": 4, "unit": "bar", "overridePolicy": "with-reason" }],
      "measurement": "主要段落的小節數為此值的倍數（tools/playtest.mjs）",
      "enforcement": { "type": "script", "ref": "TwinStrike/game/tools/playtest.mjs" },
      "whyRef": "knowledge-base/16_difficulty-curve.md §4 D8",
      "howRef": "knowledge-base/16_difficulty-curve.md §2.1",
      "source": "knowledge-base/16_difficulty-curve.md",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-FX-FILTER",
      "category": "tech",
      "level": "should",
      "scope": { "selector": { "kind": "game-build" } },
      "constraints": [{ "name": "allowed", "op": "==", "value": true, "unit": "bool", "overridePolicy": "with-reason" }],
      "measurement": "Pixi filter 是否允許使用（只在作用期間掛上、集中在一個頂層 container）",
      "enforcement": { "type": "review", "checklist": "grep 'filters' 與 DC 計數器" },
      "whyRef": "knowledge-base/05_juice-and-feel.md",
      "howRef": ".claude/skills/lite-skillgame-stack/references/juice.md",
      "source": "CLAUDE.md 已知覆寫表",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-LEGAL-EXCLUDE-CHANCE",
      "category": "legal",
      "level": "should",
      "jurisdiction": ["US-*", "TW"],
      "scope": { "selector": { "kind": "game-design" } },
      "constraints": [{ "name": "excluded", "check": "結果主要由機率或營運商設定決定者、傳統博弈形式（老虎機、撲克、麻將、牌戲）不做", "overridePolicy": "forbid" }],
      "measurement": "立項時依排除標準逐條檢核",
      "enforcement": { "type": "review", "checklist": "gdd 立項頁附檢核結果" },
      "whyRef": "knowledge-base/02_market-and-legal.md §4",
      "howRef": "knowledge-base/01_skill-integrity.md",
      "source": "knowledge-base/02_market-and-legal.md（非法律意見；上線前需法務）",
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "RULE-ART-TW-TABOO",
      "category": "art",
      "level": "must",
      "jurisdiction": ["TW"],
      "scope": { "selector": { "kind": "art-asset" } },
      "constraints": [{ "name": "taboo", "check": "不戴綠色頭飾；不用大面積純白 / 純黑；不用紅金大面積娛樂城視覺；不出現錢幣、骰子、轉盤、「倍」「爆分」；不做神明、招財貓", "overridePolicy": "forbid" }],
      "measurement": "每張生成圖人工驗收",
      "enforcement": { "type": "review", "checklist": "美術驗收清單" },
      "whyRef": "SwarmDuel/knowledge/themes/tw-themes.md §4–5",
      "howRef": "TwinStrike/gdd/02_art_spec.md §1",
      "source": "SwarmDuel/knowledge/themes/tw-themes.md",
      "reviewedAt": "2026-10-21"
    }
  ]
}
