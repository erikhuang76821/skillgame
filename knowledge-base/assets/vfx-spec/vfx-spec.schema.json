{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixiJS VFX Spec v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "template",
    "modules",
    "tags",
    "intent",
    "space",
    "anchor",
    "target",
    "trigger",
    "timeline",
    "params",
    "layers",
    "quality",
    "checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "template": {
      "enum": [
        "projectile",
        "beam",
        "telegraph",
        "impact",
        "slash",
        "field",
        "flow",
        "shield",
        "portal",
        "distortion",
        "screen"
      ]
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "projectile",
          "beam",
          "telegraph",
          "impact",
          "slash",
          "field",
          "flow",
          "shield",
          "portal",
          "distortion",
          "screen",
          "trail",
          "hit_pacing",
          "seamless_loop",
          "pixel_profile",
          "debug_guides"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "string"
    },
    "space": {
      "enum": [
        "world",
        "screen",
        "hud"
      ]
    },
    "anchor": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "trigger": {
      "type": "object",
      "required": [
        "start",
        "impact",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "impact": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": "string"
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "unit",
        "basis",
        "preview",
        "runtimeImpact"
      ],
      "properties": {
        "unit": {
          "const": "s"
        },
        "basis": {
          "enum": [
            "企劃指定",
            "來源程式",
            "影片量測",
            "畫面觀察",
            "暫定",
            "未知"
          ]
        },
        "runtimeImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "at",
              "action"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "action": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "basis",
          "range"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "企劃指定",
              "來源程式",
              "影片量測",
              "畫面觀察",
              "暫定",
              "未知"
            ]
          },
          "range": {
            "type": [
              "object",
              "null"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "low"
      ],
      "properties": {
        "low": {
          "type": "object"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "string"
    }
  }
}
