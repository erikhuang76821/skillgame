  "modules": [
    {
      "id": "trail",
      "purpose": "跟隨移動物件，不獨立判定命中",
      "parameters": [
        "sample_count",
        "length",
        "lifetime_s",
        "alpha_curve"
      ],
      "pixi": "以時間與路徑取樣，低畫質縮短拖尾"
    },
    {
      "id": "hit_pacing",
      "purpose": "命中節奏與打擊回饋",
      "parameters": [
        "anticipation_s",
        "hit_stop_s",
        "shake_px",
        "flash_gain",
        "decay_s"
      ],
      "pixi": "GSAP 編排演出；震屏只套指定鏡頭層，預設排除 HUD"
    },
    {
      "id": "seamless_loop",
      "purpose": "持續場、護盾或附魔可獨立循環",
      "parameters": [
        "loop_start_s",
        "loop_end_s",
        "exit_s"
      ],
      "pixi": "分開起手、循環、退出；驗收接縫"
    },
    {
      "id": "pixel_profile",
      "purpose": "只在指定像素風時啟用",
      "parameters": [
        "internal_width_px",
        "internal_height_px",
        "animation_fps",
        "outline_px",
        "palette",
        "dither"
      ],
      "pixi": "固定低解析畫布、整數倍率與最近鄰取樣"
    },
    {
      "id": "debug_guides",
      "purpose": "顯示運動、遮擋、預警與命中形狀，不輸出到正式素材",
      "parameters": [
        "path_overlay",
        "anchors",
        "mask_outline",
        "hit_shape_overlay"
      ],
      "pixi": "另建除錯層，能疊加、單獨顯示或完全關閉"
    }
  ]
